# Consume the metadata generated by Vitis from the selected domain. No lab map.
set(GB_BINDINGS "/* Generated from the selected Vitis platform; do not edit. */\n#include \"xparameters.h\"\n#define GB_CPU_HZ XPAR_CPU_CORE_CLOCK_FREQ_HZ\n")

function(gb_address driver macro)
  string(TOUPPER "${driver}" upper)
  list(LENGTH ${upper}_NUM_DRIVER_INSTANCES count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "GameBub template requires exactly one ${driver}; found ${count}. Make an explicit instance-selection variant for multiple instances.")
  endif()
  list(GET ${upper}0_PROP_LIST 0 base)
  string(APPEND GB_BINDINGS "#define GB_${macro} ${base}U\n")
  set(GB_BINDINGS "${GB_BINDINGS}" PARENT_SCOPE)
endfunction()

function(gb_ram driver macro bytes)
  string(TOUPPER "${driver}" upper)
  list(GET ${upper}_NUM_DRIVER_INSTANCES 0 instance)
  string(TOUPPER "${instance}" prefix)
  string(REGEX REPLACE "[^A-Z0-9_]" "_" prefix "${prefix}")
  find_file(GB_XPARAMETERS xparameters.h PATHS ${CMAKE_INCLUDE_PATH} NO_DEFAULT_PATH REQUIRED)
  file(STRINGS "${GB_XPARAMETERS}" base_line
       REGEX "^#define[ \t]+XPAR_${prefix}_BASEADDR_1[ \t]+")
  if(NOT base_line)
    message(FATAL_ERROR "Missing ${instance} MEM_AXI base in generated xparameters.h. Expose its RAM aperture to this processor, not only CTRL_AXI.")
  endif()
  string(REGEX REPLACE "^#define[ \t]+[^ \t]+[ \t]+([^ \t]+).*" "\\1" base "${base_line}")
  string(APPEND GB_BINDINGS "#define GB_${macro}_MEMORY_BASE ${base}U\n#define GB_${macro}_MEMORY_SIZE ${bytes}U\n")
  set(GB_BINDINGS "${GB_BINDINGS}" PARENT_SCOPE)
endfunction()

foreach(pair "gbesp32;ESP32_BASE" "gbaudio;AUDIO_BASE" "gbsram;SRAM_CTRL_BASE"
             "gbsdram;SDRAM_CTRL_BASE" "gpio;VIBRATION_BASE" "v_tpg;TPG_BASE" "intc;INTC_BASE")
  list(GET pair 0 driver)
  list(GET pair 1 macro)
  if(driver IN_LIST GB_NATIVE_DEPS)
    gb_address("${driver}" "${macro}")
  endif()
endforeach()
if("gbsram" IN_LIST GB_NATIVE_DEPS)
  gb_ram(gbsram SRAM 0x80000)
endif()
if("gbsdram" IN_LIST GB_NATIVE_DEPS)
  gb_ram(gbsdram SDRAM 0x2000000)
endif()
if(GB_NATIVE_IRQ)
  list(LENGTH GBESP320_PROP_LIST prop_count)
  if(NOT prop_count EQUAL 2)
    message(FATAL_ERROR "ESP32 requires generated reg and interrupts metadata")
  endif()
  list(GET GBESP320_PROP_LIST 1 packed_irq)
  list(GET GBESP320_PROP_LIST 0 esp_base)
  list(GET INTC0_PROP_LIST 0 intc_base)
  # Phandles can be renumbered between Lopper calls. Resolve BOTH endpoints
  # in one exported DTS, matching register bases rather than instance names.
  set(intc_phandle "")
  set(intc_label "")
  set(esp_parent "")
  foreach(include_dir IN LISTS CMAKE_INCLUDE_PATH)
    file(GLOB domain_dts "${include_dir}/../hw_artifacts/*_baremetal.dts")
    foreach(dts IN LISTS domain_dts)
      file(READ "${dts}" dts_text)
      string(REPLACE ";" "\n" dts_text "${dts_text}")
      string(REGEX MATCHALL "[^{}]+\\{[^{}]*\\}" leaf_nodes "${dts_text}")
      foreach(node IN LISTS leaf_nodes)
        if(node MATCHES "\"xlnx,axi-intc-")
          string(REGEX MATCH "reg[ \t\r\n]*=[ \t\r\n]*<([0-9a-fA-Fx]+)[ \t\r\n]+" match "${node}")
          set(node_base "${CMAKE_MATCH_1}")
          if(node_base AND node_base EQUAL intc_base)
            string(REGEX MATCH "phandle[ \t\r\n]*=[ \t\r\n]*<([0-9a-fA-Fx]+)>" match "${node}")
            set(intc_phandle "${CMAKE_MATCH_1}")
            string(REGEX MATCH "([A-Za-z_][A-Za-z0-9_]*):[ \t\r\n]*[^{}]+\\{" match "${node}")
            set(intc_label "${CMAKE_MATCH_1}")
          endif()
        endif()
        if(node MATCHES "\"xlnx,gamebub-esp32-v102-")
          string(REGEX MATCH "reg[ \t\r\n]*=[ \t\r\n]*<([0-9a-fA-Fx]+)[ \t\r\n]+" match "${node}")
          set(node_base "${CMAKE_MATCH_1}")
          if(node_base AND node_base EQUAL esp_base)
            string(REGEX MATCH "interrupt-parent[ \t\r\n]*=[ \t\r\n]*<([^>]+)>" match "${node}")
            string(STRIP "${CMAKE_MATCH_1}" esp_parent)
          endif()
        endif()
      endforeach()
    endforeach()
  endforeach()
  if(NOT intc_phandle OR NOT esp_parent)
    message(FATAL_ERROR "Cannot resolve ESP32 and AXI INTC in the selected domain's hw_artifacts/*_baremetal.dts")
  endif()
  math(EXPR flags "(${packed_irq} >> 12) & 15")
  math(EXPR irq "${packed_irq} & 4095")
  set(parent_matches 0)
  if(intc_label AND esp_parent STREQUAL "&${intc_label}")
    set(parent_matches 1)
  elseif(esp_parent MATCHES "^(0x[0-9a-fA-F]+|[0-9]+)$")
    if(esp_parent EQUAL intc_phandle)
      set(parent_matches 1)
    endif()
  endif()
  if(NOT flags EQUAL 2 OR NOT parent_matches)
    message(FATAL_ERROR "Buttons IRQ template requires level-high ESP32 interrupt directly on the selected AXI INTC")
  endif()
  string(APPEND GB_BINDINGS "#define GB_ESP32_IRQ ${irq}U\n")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/platform_bindings.h" "${GB_BINDINGS}")

# Select a unique local BRAM node rather than accidentally executing in the
# external memory that an advanced app might later test or reconfigure.
set(gb_boot_memories "")
foreach(memory IN LISTS TOTAL_MEM_CONTROLLERS)
  if(memory MATCHES "lmb_bram_if_cntlr")
    list(APPEND gb_boot_memories "${memory}")
  endif()
endforeach()
list(LENGTH gb_boot_memories gb_boot_count)
if(NOT gb_boot_count EQUAL 1)
  message(FATAL_ERROR "GameBub examples require one unambiguous LMB BRAM region")
endif()
list(GET gb_boot_memories 0 CODE)
set(DATA "${CODE}")
set(DDR "${CODE}")
set(STACK_SIZE 0x800)
set(HEAP_SIZE 0x0)
