# GameBub native board constraints. Physical pin data comes from BOARD_PART.
package require xilinx::board 1.0
namespace import ::xilinx::board::*
set f_xdc [add_ipfile -usedIn {synthesis implementation board} -force [current_inst]_board.xdc]
puts_ipfile $f_xdc {# GameBub board constraints; Custom interfaces intentionally remain unbound.}
if {[get_project_property BOARD] eq ""} {close_ipfile $f_xdc; return}
set board_if [get_property PARAM_VALUE.LCD_BOARD_INTERFACE]
if {$board_if ne "Custom" && $board_if ne ""} {
 board_add_port_constraints $f_xdc $board_if R lcd_data_r 8
 board_add_port_constraints $f_xdc $board_if G lcd_data_g 8
 board_add_port_constraints $f_xdc $board_if B lcd_data_b 8
 board_add_port_constraints $f_xdc $board_if DOTCLK lcd_dotclk 1
 board_add_port_constraints $f_xdc $board_if HSYNC lcd_hsync 1
 board_add_port_constraints $f_xdc $board_if VSYNC lcd_vsync 1
 board_add_port_constraints $f_xdc $board_if DE lcd_data_en 1
}
close_ipfile $f_xdc
