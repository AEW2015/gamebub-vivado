# GameBub GUI-only common template; bundled into each versioned IP.
# Uses the same native board helper as AMD AXI GPIO / Clocking Wizard 2025.2.
package require xilinx::board 1.0
namespace import ::xilinx::board::*
namespace eval ::gamebub_gui {}
proc ::gamebub_gui::board_choices {vlnv mode ports} {
 if {[::ipxit::get_project_property BOARD] eq ""} {return Custom}
 set result [list Custom]
 foreach intf [get_board_part_interfaces -filter "VLNV == $vlnv && MODE == $mode"] {
  set compatible 1
  foreach {name width direction} $ports {
   if {[llength [get_board_interface_ports -of_objects $intf -filter "LOGICAL_NAME == $name && WIDTH == $width && DIRECTION == $direction"]]!=1} {set compatible 0;break}
  }
  if {$compatible} {lappend result [get_property NAME $intf]}
 }
 return [join [lsort -unique $result] ,]
}
proc ::gamebub_gui::note {inst parent name text} {
 return [ipgui::add_static_text $inst -parent $parent -name $name -text $text]
}
proc ::gamebub_gui::parameter {inst parent name label tip {widget {}}} {
 if {$widget eq ""} {set p [ipgui::add_param $inst -parent $parent -name $name]} else {set p [ipgui::add_param $inst -parent $parent -name $name -widget $widget]}
 set_property display_name $label $p
 set_property tooltip $tip $p
 return $p
}
proc ::gamebub_gui::integer_ok {object lo hi {align 1}} {
 set v [get_property value $object]
 if {![string is wideinteger -strict $v] || $v<$lo || $v>$hi || $v%$align!=0} {
  set_property errmsg "Enter an integer from $lo to $hi, aligned to $align." $object
  return false
 }
 return true
}
proc ::gamebub_gui::bool_value {object} {
 # Vivado GUI paramvalues may be TRUE/FALSE, whereas XCI uses true/false.
 # Use Tcl boolean conversion, not a case-sensitive string membership test.
 set v [get_property value $object]
 if {[info exists ::env(GAMEBUB_GUI_TRACE)]} {puts "GAMEBUB_GUI_BOOL object=$object value=<$v>"}
 return [expr {$v ? 1 : 0}]
}
proc ::gamebub_gui::bool_text {object} {
 # XGUI enum-valued enabled/visible properties require literal true/false.
 return [expr {[::gamebub_gui::bool_value $object] ? "true" : "false"}]
}

proc init_gui {IPINST} {
 ipgui::add_param $IPINST -name Component_Name
 add_board_tab $IPINST -display_name {SRAM_BOARD_INTERFACE {SRAM}}
 set page [ipgui::add_page $IPINST -name {IP Configuration} -layout vertical]
 ::gamebub_gui::note $IPINST $page overview {512 KiB asynchronous SRAM with 100 MHz AXI host interfaces.
Connect both MEM_AXI and CTRL_AXI to the same host_clk / active-low host_resetn.}
 set group [ipgui::add_group $IPINST -parent $page -name {Memory interface} -layout vertical]
 ::gamebub_gui::note $IPINST $group note_0 {MEM_AXI is the linker-visible memory aperture; CTRL_AXI is for ownership, status and tests.
The internal 100/400 MHz PHY clocks are generated by this controller.}
 set p [::gamebub_gui::parameter $IPINST $group C_MEMORY_BYTES {Installed SRAM capacity (bytes)} {Fixed board memory capacity: 524288 bytes (512 KiB). Not a runtime allocator.} {}]
 set_property enabled false $p
 set group [ipgui::add_group $IPINST -parent $page -name {Tester defaults} -layout vertical]
 ::gamebub_gui::note $IPINST $group note_1 {Only implemented settings are exposed. Software may update tester settings through CTRL_AXI.}
 set p [::gamebub_gui::parameter $IPINST $group C_ADVANCED_SETTINGS {Edit advanced tester defaults} {Enables the implemented default destructive-test span below. This checkbox changes the GUI only.} {checkBox}]
 set p [::gamebub_gui::parameter $IPINST $group C_DEFAULT_TEST_WORDS {Initial test span (16-bit words)} {Initial tester word count, 1..262144. The generated RTL parameter DEFAULT_TEST_WORDS changes with this setting. Memory testing is destructive.} {}]
}
proc update_PARAM_VALUE.SRAM_BOARD_INTERFACE {IPINST PARAM_VALUE.SRAM_BOARD_INTERFACE PROJECT_PARAM.BOARD} {
 set_property range [::gamebub_gui::board_choices gamebub.org:interface:sram_rtl:1.0 master {A 18 out IO 16 inout CE_N 1 out OE_N 1 out WE_N 1 out UB_N 1 out LB_N 1 out}] ${PARAM_VALUE.SRAM_BOARD_INTERFACE}
}
proc validate_PARAM_VALUE.SRAM_BOARD_INTERFACE {PARAM_VALUE.SRAM_BOARD_INTERFACE PROJECT_PARAM.BOARD} {
 set choices [split [::gamebub_gui::board_choices gamebub.org:interface:sram_rtl:1.0 master {A 18 out IO 16 inout CE_N 1 out OE_N 1 out WE_N 1 out UB_N 1 out LB_N 1 out}] ,]
 if {[get_property value ${PARAM_VALUE.SRAM_BOARD_INTERFACE}] ni $choices} {
  set_property errmsg {Choose Custom or a compatible interface on the selected board.} ${PARAM_VALUE.SRAM_BOARD_INTERFACE}
  return false
 }
 return true
}
proc update_PARAM_VALUE.C_DEFAULT_TEST_WORDS {PARAM_VALUE.C_DEFAULT_TEST_WORDS PARAM_VALUE.C_ADVANCED_SETTINGS} {
 set_property enabled [::gamebub_gui::bool_text ${PARAM_VALUE.C_ADVANCED_SETTINGS}] ${PARAM_VALUE.C_DEFAULT_TEST_WORDS}
}
proc validate_PARAM_VALUE.C_DEFAULT_TEST_WORDS {PARAM_VALUE.C_DEFAULT_TEST_WORDS} {return [::gamebub_gui::integer_ok ${PARAM_VALUE.C_DEFAULT_TEST_WORDS} 1 262144 1]}
proc update_MODELPARAM_VALUE.C_DEFAULT_TEST_WORDS {MODELPARAM_VALUE.C_DEFAULT_TEST_WORDS PARAM_VALUE.C_DEFAULT_TEST_WORDS} {set_property value [get_property value ${PARAM_VALUE.C_DEFAULT_TEST_WORDS}] ${MODELPARAM_VALUE.C_DEFAULT_TEST_WORDS}}
proc update_PARAM_VALUE.C_MEMORY_BYTES {PARAM_VALUE.C_MEMORY_BYTES} {set_property enabled false ${PARAM_VALUE.C_MEMORY_BYTES}}
proc validate_PARAM_VALUE.C_MEMORY_BYTES {PARAM_VALUE.C_MEMORY_BYTES} {return [::gamebub_gui::integer_ok ${PARAM_VALUE.C_MEMORY_BYTES} 524288 524288]}
proc update_PARAM_VALUE.C_ADVANCED_SETTINGS {PARAM_VALUE.C_ADVANCED_SETTINGS} {
 
}
proc validate_PARAM_VALUE.C_ADVANCED_SETTINGS {PARAM_VALUE.C_ADVANCED_SETTINGS} {return true}
